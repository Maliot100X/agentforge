generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id          String   @id @default(cuid())
  agentId     String   @unique @map("agent_id")
  apiKey      String   @unique @map("api_key")
  name        String
  description String?
  avatar      String?
  twitter     String?
  telegram    String?
  website     String?
  wallet      String   @unique
  reputation  Float    @default(0)
  totalEarned Float    @default(0) @map("total_earned")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tokens     Token[]
  bounties   Bounty[] @relation("BountyCreator")
  claims     Bounty[] @relation("BountyClaimer")
  tasks      Task[]   @relation("TaskCreator")
  taskClaims Task[]   @relation("TaskClaimer")
  trades     Trade[]
  services   Service[]

  @@map("agents")
}

model Token {
  id                 String   @id @default(cuid())
  mint               String   @unique
  name               String
  symbol             String
  imageUrl           String?  @map("image_url")
  description        String?
  agentId            String   @map("agent_id")
  agent              Agent    @relation(fields: [agentId], references: [id])
  agentWallet        String   @map("agent_wallet")
  txSignature        String?  @map("tx_signature")
  pumpUrl            String?  @map("pump_url")
  fundingSource      String   @default("gasless") @map("funding_source")
  mcap               Float?
  price              Float?
  volume24h          Float?   @map("volume_24h")
  creatorFeesTotal   Float    @default(0) @map("creator_fees_total")
  feesDistributed    Float    @default(0) @map("fees_distributed")
  status             String   @default("launching")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  feeDistributions FeeDistribution[]

  @@map("tokens")
}

model FeeDistribution {
  id          String   @id @default(cuid())
  tokenMint   String   @map("token_mint")
  token       Token    @relation(fields: [tokenMint], references: [mint])
  agentId     String   @map("agent_id")
  agentWallet String   @map("agent_wallet")
  amountSol   Float    @map("amount_sol")
  txSignature String?  @map("tx_signature")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("fee_distributions")
}

model FundedDeposit {
  id           String   @id @default(cuid())
  agentId      String   @map("agent_id")
  txHash       String   @unique @map("tx_hash")
  amountSol    Float    @map("amount_sol")
  verified     Boolean  @default(false)
  usedForLaunch Boolean @default(false) @map("used_for_launch")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("funded_deposits")
}

model Bounty {
  id          String    @id @default(cuid())
  title       String
  description String
  reward      Float
  rewardToken String    @default("USDC") @map("reward_token")
  status      String    @default("open")
  creatorId   String    @map("creator_id")
  creator     Agent     @relation("BountyCreator", fields: [creatorId], references: [id])
  claimerId   String?   @map("claimer_id")
  claimer     Agent?    @relation("BountyClaimer", fields: [claimerId], references: [id])
  submission  String?
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("bounties")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String
  reward      Float
  rewardToken String    @default("USDC") @map("reward_token")
  status      String    @default("open")
  creatorId   String    @map("creator_id")
  creator     Agent     @relation("TaskCreator", fields: [creatorId], references: [id])
  claimerId   String?   @map("claimer_id")
  claimer     Agent?    @relation("TaskClaimer", fields: [claimerId], references: [id])
  submission  String?
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("tasks")
}

model Trade {
  id           String   @id @default(cuid())
  agentId      String   @map("agent_id")
  agent        Agent    @relation(fields: [agentId], references: [id])
  inputMint    String   @map("input_mint")
  outputMint   String   @map("output_mint")
  inputAmount  Float    @map("input_amount")
  outputAmount Float    @map("output_amount")
  txSignature  String?  @map("tx_signature")
  status       String   @default("pending")
  pnl          Float    @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("trades")
}

model Service {
  id          String   @id @default(cuid())
  agentId     String   @map("agent_id")
  agent       Agent    @relation(fields: [agentId], references: [id])
  title       String
  description String
  price       Float
  currency    String   @default("USDC")
  category    String
  rating      Float    @default(0)
  totalOrders Int      @default(0) @map("total_orders")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}
